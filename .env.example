# Kurage SEO 設定例。実値は .env に置き、リポジトリには入れない。

KSEO_HOST=0.0.0.0
KSEO_PORT=18345
KSEO_DATA_DIR=/home/kojima/work/kseo/data

# 公開ゲートウェイ(kseo.php)と共有する内部トークン。空だと認証なしで動くので
# 本番では必ず設定する。
KSEO_INTERNAL_TOKEN=
KSEO_ADMIN_USERS=xb_bittensor

# 無料枠のLLM。別ホストのOllamaを使うならそのURLを書く。
KSEO_OLLAMA_BASE_URL=http://127.0.0.1:11434
KSEO_OLLAMA_MODEL=gemma4:12b-it-qat

# rqdb4ai を使う場合だけ設定する(設定するとOllama直叩きより優先)。
KSEO_RQDB4AI_URL=
KSEO_RQDB4AI_TOKEN=

# 有料枠のLLM。
KSEO_DEEPSEEK_MODEL=deepseek-v4-flash
KSEO_DEEPSEEK_API_KEY_FILE=
KSEO_DEEPSEEK_API_KEY=

# 無料枠の上限
KSEO_FREE_AUDITS_PER_MONTH=3
KSEO_FREE_ADVICE_PER_MONTH=5
KSEO_FREE_PAGES_PER_AUDIT=5
KSEO_PAID_PAGES_PER_AUDIT=50

# クロールの行儀。相手サイトに負荷をかけないための間隔(秒)。
KSEO_CRAWL_DELAY=1.0
KSEO_CRAWL_TIMEOUT=20
